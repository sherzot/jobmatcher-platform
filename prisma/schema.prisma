// ─────────────────────────────────────────────────────────────
// JobMatch Platform — Prisma Schema
// MySQL 8.0 | Prisma 5.x
// ─────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CANDIDATE
  AGENT
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

/// Company registration approval status (set by Agent)
enum CompanyStatus {
  PENDING_APPROVAL  // Registered, waiting agent review
  APPROVED          // Agent approved — can login and operate
  REJECTED          // Agent rejected — must re-apply or contact support
  SUSPENDED         // Suspended by Admin
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW  // Company submitted, waiting agent approval
  ACTIVE
  PAUSED
  CLOSED
  REJECTED        // Agent rejected — company must revise
  DELETED
}

enum SalaryType {
  HOURLY    // 時給
  MONTHLY   // 月給
  ANNUAL    // 年収
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkLocation {
  ONSITE
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  PENDING
  CASUAL_INTERVIEW
  SCREENING
  FIRST_INTERVIEW
  SECOND_INTERVIEW
  THIRD_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum VisaStatus {
  NOT_REQUIRED
  SPONSORED
  SELF_SPONSORED
  ALREADY_HAVE
}

enum JapaneseLevel {
  N1
  N2
  N3
  N4
  N5
  BUSINESS
  NATIVE
  NONE
}

enum ConversationType {
  APPLICATION_AGENT_CANDIDATE
  APPLICATION_AGENT_COMPANY
  APPLICATION_CANDIDATE_COMPANY
  GENERAL_AGENT_CANDIDATE
  GENERAL_AGENT_COMPANY
  ADMIN_SUPPORT
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  NEW_MESSAGE
  NEW_JOB_MATCH
  INTERVIEW_SCHEDULED
  OFFER_RECEIVED
  COMPANY_REGISTRATION         // Agent notified: new company pending approval
  COMPANY_APPROVED             // Company notified: approved by agent
  COMPANY_REJECTED             // Company notified: rejected by agent
  SYSTEM
}

// ─────────────────────────────────────────────────────────────
// USER  (auth table only — no business code here)
// ─────────────────────────────────────────────────────────────

model User {
  id       Int        @id @default(autoincrement())
  email    String     @unique @db.VarChar(255)
  password String     @db.VarChar(255)
  role     UserRole   @default(CANDIDATE)
  status   UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Role-specific profiles (only one is populated per user)
  candidate Candidate?
  agent     Agent?
  company   Company?
  admin     Admin?

  // Cross-role relations
  applications  Application[]
  sentMessages  Message[]      @relation("SentMessages")
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// CANDIDATE  (ish izlovchi — role = CANDIDATE)
// BUSINESS IDENTIFIER: user_code = U0000001
// ─────────────────────────────────────────────────────────────

model Candidate {
  id       Int    @id @default(autoincrement())
  userCode String @unique @default("") @db.VarChar(12) // U0000001 — auto-set after insert

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 基本情報
  firstName     String  @db.VarChar(100)
  lastName      String  @db.VarChar(100)
  firstNameKana String? @db.VarChar(100)
  lastNameKana  String? @db.VarChar(100)
  dateOfBirth   DateTime?
  gender        String? @db.VarChar(20)
  phone         String? @db.VarChar(20)
  avatarUrl     String? @db.VarChar(500)

  // Location
  country    String? @db.VarChar(100)
  prefecture String? @db.VarChar(100)
  city       String? @db.VarChar(100)
  address    String? @db.Text

  // Work preferences 希望条件
  desiredJobTypes  String? @db.Text // JSON array
  desiredLocations String? @db.Text // JSON array
  desiredSalaryMin Int?
  desiredSalaryMax Int?
  availableFrom    DateTime?
  isOpenToWork     Boolean @default(true)

  // Language
  japaneseLevel  JapaneseLevel @default(NONE)
  englishLevel   String?       @db.VarChar(50)
  otherLanguages String?       @db.Text // JSON array

  // Visa
  nationality String?    @db.VarChar(100)
  visaStatus  VisaStatus @default(NOT_REQUIRED)
  visaExpiry  DateTime?

  // Career summary
  yearsOfExperience Int?
  currentSalary     Int?
  selfIntroduction  String? @db.Text // 自己紹介

  // Motivation & Strengths
  motivation String? @db.Text // 志望動機
  approach   String? @db.Text // 取り組み方
  strengths  String? @db.Text // 強み

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume Resume?

  @@index([userCode])
  @@map("candidates")
}

// ─────────────────────────────────────────────────────────────
// RESUME (履歴書・職務経歴書)
// ─────────────────────────────────────────────────────────────

model Resume {
  id          Int       @id @default(autoincrement())
  candidateId Int       @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  title          String  @default("My Resume") @db.VarChar(200)
  isPublic       Boolean @default(false)
  pdfUrl         String? @db.VarChar(500)
  uploadedPdfUrl String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educations     Education[]
  experiences    Experience[]
  skills         Skill[]
  qualifications Qualification[]

  @@map("resumes")
}

// 学歴 (max 3)
model Education {
  id       Int    @id @default(autoincrement())
  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  schoolName  String  @db.VarChar(200)
  faculty     String? @db.VarChar(200)
  degree      String? @db.VarChar(100)
  startDate   String  @db.VarChar(20)
  endDate     String? @db.VarChar(20)
  isGraduated Boolean @default(true)
  description String? @db.Text
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educations")
}

// 経歴 (max 10)
model Experience {
  id       Int    @id @default(autoincrement())
  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  companyName   String  @db.VarChar(200)
  position      String  @db.VarChar(200)
  employeeCount String? @db.VarChar(50)
  startDate     String  @db.VarChar(20)
  endDate       String? @db.VarChar(20)
  isCurrent     Boolean @default(false)
  description   String? @db.Text
  achievements  String? @db.Text
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("experiences")
}

// スキル (unlimited)
model Skill {
  id       Int    @id @default(autoincrement())
  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(100)
  level     String? @db.VarChar(50)
  yearsUsed Int?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

// 資格 (unlimited)
model Qualification {
  id       Int    @id @default(autoincrement())
  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  name       String  @db.VarChar(200)
  issuedBy   String? @db.VarChar(200)
  issuedDate String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qualifications")
}

// ─────────────────────────────────────────────────────────────
// COMPANY  (role = COMPANY)
// BUSINESS IDENTIFIER: company_code = C0000001
// Registration requires Agent approval before login is allowed
// ─────────────────────────────────────────────────────────────

model Company {
  id          Int           @id @default(autoincrement())
  companyCode String        @unique @default("") @db.VarChar(12) // C0000001 — auto-set after insert
  status      CompanyStatus @default(PENDING_APPROVAL)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String  @db.VarChar(200)
  nameKana      String? @db.VarChar(200)
  nameEn        String? @db.VarChar(200)
  logoUrl       String? @db.VarChar(500)
  websiteUrl    String? @db.VarChar(500)
  description   String? @db.Text
  industry      String? @db.VarChar(100)
  employeeCount String? @db.VarChar(50)
  founded       Int?

  // Location
  country    String? @db.VarChar(100)
  prefecture String? @db.VarChar(100)
  city       String? @db.VarChar(100)
  address    String? @db.Text

  // Registration / approval
  registrationNote  String? @db.Text    // Company's note when registering
  businessRegNumber String? @db.VarChar(100) // 法人番号 (Japan) / registration number
  rejectionReason   String? @db.Text    // Set by agent when rejecting
  approvedAt        DateTime?
  approvedByAgentId Int?                // Agent.id who approved

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentCompanies AgentCompany[]
  jobs           Job[]

  @@index([companyCode])
  @@index([status])
  @@index([name])
  @@map("companies")
}

// ─────────────────────────────────────────────────────────────
// AGENT  (role = AGENT — created by Admin only)
// BUSINESS IDENTIFIER: agent_code = A0000001
// ─────────────────────────────────────────────────────────────

model Agent {
  id        Int    @id @default(autoincrement())
  agentCode String @unique @default("") @db.VarChar(12) // A0000001 — auto-set after insert

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String  @db.VarChar(200)
  bio         String? @db.Text
  avatarUrl   String? @db.VarChar(500)
  phone       String? @db.VarChar(20)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentCompanies AgentCompany[]
  conversations  Conversation[]

  @@index([agentCode])
  @@map("agents")
}

// Agent ↔ Company (many-to-many)
model AgentCompany {
  id        Int     @id @default(autoincrement())
  agentId   Int
  companyId Int
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  @@unique([agentId, companyId])
  @@map("agent_companies")
}

// ─────────────────────────────────────────────────────────────
// ADMIN  (role = ADMIN — created via seed or by super admin)
// BUSINESS IDENTIFIER: admin_code = admin1, admin2, ...
// ─────────────────────────────────────────────────────────────

model Admin {
  id        Int    @id @default(autoincrement())
  adminCode String @unique @default("") @db.VarChar(20) // admin1, admin2 — auto-set after insert

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String  @db.VarChar(200)
  isSuperAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminCode])
  @@map("admins")
}

// ─────────────────────────────────────────────────────────────
// JOB
// BUSINESS IDENTIFIER: job_code = J0000001
// ─────────────────────────────────────────────────────────────

model Job {
  id      Int    @id @default(autoincrement())
  jobCode String @unique @default("") @db.VarChar(12) // J0000001 — auto-set after insert

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title        String  @db.VarChar(300)
  description  String  @db.LongText
  requirements String? @db.Text
  benefits     String? @db.Text

  jobType      JobType      @default(FULL_TIME)
  workLocation WorkLocation @default(ONSITE)
  status       JobStatus    @default(DRAFT)

  country    String? @db.VarChar(100)
  prefecture String? @db.VarChar(100)
  city       String? @db.VarChar(100)

  salaryType     SalaryType @default(ANNUAL)
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String     @default("JPY") @db.VarChar(10)

  japaneseLevel   JapaneseLevel @default(NONE)
  visaSponsorship Boolean       @default(false)
  minExperience   Int?
  skills          String?       @db.Text // JSON array

  viewCount  Int @default(0)
  applyCount Int @default(0)

  createdByRole   String    @default("COMPANY") @db.VarChar(20)
  createdById     Int
  rejectionReason String?   @db.Text
  reviewedAt      DateTime?
  reviewedById    Int?

  publishedAt DateTime?
  closesAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]

  @@index([jobCode])
  @@index([status])
  @@index([jobType])
  @@index([workLocation])
  @@index([prefecture])
  @@index([japaneseLevel])
  @@fulltext([title, description])
  @@map("jobs")
}

// ─────────────────────────────────────────────────────────────
// APPLICATION
// BUSINESS IDENTIFIER: app_code = APP0000001
// ─────────────────────────────────────────────────────────────

model Application {
  id      Int    @id @default(autoincrement())
  appCode String @unique @default("") @db.VarChar(14) // APP0000001 — auto-set after insert

  userId Int
  jobId  Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status          ApplicationStatus @default(PENDING)
  coverLetter     String?           @db.Text
  resumeSnapshot  String?           @db.LongText // JSON snapshot at apply time

  agentNote       String? @db.Text
  rejectionReason String? @db.Text

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory ApplicationStatusHistory[]
  conversation  Conversation?

  @@unique([userId, jobId])
  @@index([appCode])
  @@index([status])
  @@index([userId])
  @@index([jobId])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  note       String?           @db.Text
  changedBy  Int?

  createdAt DateTime @default(now())

  @@map("application_status_history")
}

// ─────────────────────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────────────────────

model Conversation {
  id   Int              @id @default(autoincrement())
  type ConversationType

  applicationId Int?         @unique
  application   Application? @relation(fields: [applicationId], references: [id])

  agentId     Int?
  agent       Agent?  @relation(fields: [agentId], references: [id])
  candidateId Int?    // userId of candidate
  companyId   Int?    // Company.id

  agentEnabled Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([applicationId])
  @@index([agentId])
  @@index([candidateId])
  @@index([companyId])
  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation("SentMessages", fields: [senderId], references: [id])

  type    MessageType @default(TEXT)
  content String      @db.Text
  fileUrl String?     @db.VarChar(500)

  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   NotificationType
  title  String           @db.VarChar(300)
  body   String           @db.Text
  data   String?          @db.Text // JSON payload
  isRead Boolean          @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────────────────────

model RefreshToken {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}
