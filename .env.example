# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─────────────────────────────────────────────
# DATABASE (MySQL)
# ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=jobmatcher_db
MYSQL_USER=jobmatcher
MYSQL_PASSWORD=jobmatcher123
MYSQL_PORT=3306

DATABASE_URL="mysql://jobmatcher:jobmatcher123@localhost:3306/jobmatcher_db"

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# FILE STORAGE (MinIO / S3)
# ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false

S3_BUCKET_RESUMES=resumes
S3_BUCKET_AVATARS=avatars
S3_BUCKET_LOGOS=logos
S3_BUCKET_GENERATED=generated

# ─────────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="JobMatch Platform <noreply@jobmatch.com>"

# ─────────────────────────────────────────────
# AI SERVICE
# ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# FRONTEND (Next.js)
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME="JobMatch Platform"
NEXT_PUBLIC_APP_LOCALE=ja
